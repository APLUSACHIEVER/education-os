# APLUS ACHIEVER Education OS — Apache / Namecheap Shared Hosting
Options -Indexes
DirectoryIndex index.html

# Correct MIME types for PWA assets
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg

<IfModule mod_headers.c>
  # Ensure the app shell and service worker can update promptly after deployment
  <FilesMatch "^(index\.html|sw\.js|manifest\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
